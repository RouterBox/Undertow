# Undertow service config — copy this file to .env and fill in your values.
#
#   cp service/.env.example service/.env
#
# .env is gitignored. Never commit a populated copy.

# --- Neo4j (required) ---
# Pick any password. Whatever you put here must match the password the
# Neo4j Docker container was created with — see start.sh / INSTALL.md.
NEO4J_PASS=changeme

# Optional Neo4j connection overrides. Defaults shown.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j

# --- Anthropic (required) ---
# Used by Impulse, Gobble, Dreamer, Wonder, and the historical ingestor.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Gemini (required for vector search) ---
# Used by the embedding pipeline for semantic flash retrieval.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Prowler upstream (optional) ---
# Brave Search powers fast in-turn web lookups. Without this, Prowler's
# upstream path is silently skipped.
# https://api.search.brave.com/app/keys
BRAVE_API_KEY=

# --- Prowler downstream (optional) ---
# Perplexity powers between-turn deep research that writes neurons.
# Without this, Prowler's downstream path is silently skipped.
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Embedding provider: gemini (default, needs GEMINI_API_KEY) or local
# (in-process transformers.js — no API, no network after first model download).
# After changing this, run: node switch-embeddings.js  (rebuilds the vector
# index at the new dimension count and re-embeds all live neurons).
# EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_LOCAL_MODEL=Xenova/all-MiniLM-L6-v2

# --- LLM provider (optional) ---
# Defaults reproduce the stock setup. See README "Configuration".
# UNDERTOW_LLM_PROVIDER=anthropic
# UNDERTOW_LLM_BASE_URL=
# UNDERTOW_LLM_PROVIDER_MODULE=./my-provider.mjs
# UNDERTOW_QUERY_MODEL=claude-haiku-5-5
# UNDERTOW_INGEST_MODEL=claude-haiku-5-5
# UNDERTOW_SUMMARIZE_MODEL=claude-sonnet-5
# UNDERTOW_FALLBACK_MODEL=
# ANTHROPIC_WORKSPACE_ID=

# --- Network and access (optional) ---
# Bind address. Default 127.0.0.1 (this machine only). Use 0.0.0.0 to accept
# remote callers — and set UNDERTOW_API_TOKEN when you do.
# UNDERTOW_HOST=127.0.0.1
# Bearer token required on /mcp and on mutating /undertow/* requests when set.
# UNDERTOW_API_TOKEN=
# Enable mutating MCP tools (undertow_spider, undertow_ingest, undertow_correct delete).
# UNDERTOW_MCP_ALLOW_MUTATIONS=false
